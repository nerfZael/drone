{
  "name": "@drone/hub-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/cjs/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/cjs/index.js",
      "default": "./src/index.ts"
    },
    "./sidebar": {
      "types": "./src/sidebar/index.ts",
      "import": "./src/sidebar/index.ts",
      "require": "./dist/cjs/sidebar/index.js",
      "default": "./src/sidebar/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/write-cjs-package.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && node --test tests/node/commonjs-entrypoint.node.cjs && bun test tests"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
