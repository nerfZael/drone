{
  "name": "@blip/core",
  "version": "0.1.0",
  "description": "Blip coding-agent runtime",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/check-portable-entry.mjs",
    "check:portable": "node scripts/check-portable-entry.mjs",
    "dev": "tsx src/index.ts",
    "test": "bun test tests"
  },
  "dependencies": {
    "@blip/protocol": "workspace:*",
    "@blip/tools": "workspace:*",
    "@mariozechner/pi-ai": "workspace:*",
    "@mariozechner/pi-agent-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.7.3",
    "tsx": "^4.20.5"
  }
}
