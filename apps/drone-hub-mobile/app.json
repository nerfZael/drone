{
  "expo": {
    "name": "Drone Hub Mobile",
    "slug": "drone-hub-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1e1e2e",
    "androidStatusBar": {
      "backgroundColor": "#1e1e2e",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#181825",
      "barStyle": "light-content"
    },
    "android": {
      "package": "com.dronehub.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["CAMERA"]
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Allow Drone Hub to scan a device pairing code." }],
      ["expo-secure-store", { "configureAndroidBackup": true }],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Drone Hub to record voice messages for transcription."
        }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Allow Drone Hub to attach selected images to chat prompts." }
      ]
    ]
  }
}
