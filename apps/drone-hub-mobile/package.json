{
  "name": "drone-hub-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "expo": {
    "autolinking": {
      "buildFromSource": ["expo-audio"]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:native": "expo run:android",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:blip-portability": "node scripts/check-blip-portability.mjs",
    "test": "bun test tests"
  },
  "dependencies": {
    "@blip/core": "workspace:*",
    "@blip/protocol": "workspace:*",
    "@drone/assistant-chat": "workspace:*",
    "@drone/device-protocol": "workspace:*",
    "@drone/file-icons": "workspace:*",
    "@drone/hub-model": "workspace:*",
    "@drone/markdown-table-sort": "workspace:*",
    "@blip/workspace": "workspace:*",
    "@mariozechner/pi-agent-core": "workspace:*",
    "@mariozechner/pi-ai": "workspace:*",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "base64-js": "^1.5.1",
    "beautiful-mermaid": "^1.1.3",
    "expo": "^57.0.4",
    "expo-audio": "~57.0.3",
    "expo-camera": "^57.0.1",
    "expo-clipboard": "~57.0.0",
    "expo-crypto": "^57.0.0",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.0",
    "expo-image-picker": "~57.0.5",
    "expo-secure-store": "^57.0.0",
    "expo-status-bar": "^57.0.0",
    "expo-video": "~57.0.0",
    "lucide-react-native": "^1.24.0",
    "react": "19.2.3",
    "react-native": "^0.86.0",
    "react-native-drawer-layout": "4.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "^15.15.5",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "refractor": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "~6.0.3"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}
