{
  "name": "voice-stream-next",
  "version": "0.1.34",
  "description": "VoiceStream desktop, web, Android, and assistant service.",
  "author": "Huntelkator",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "bun run scripts/dev.mjs",
    "dev:server": "bun --watch server/src/index.ts",
    "dev:web": "vite --host 0.0.0.0 --port 5185",
    "desktop": "electron desktop/main.cjs",
    "desktop:dev": "VOICE_STREAM_NEXT_WEB_URL=http://127.0.0.1:5185 electron desktop/main.cjs",
    "desktop:buildDebug": "bun scripts/pack-desktop.mjs --debug",
    "desktop:buildRelease": "bun scripts/pack-desktop.mjs --release",
    "desktop:debug": "bun scripts/build-apps.mjs --mode debug --target desktop",
    "desktop:release": "bun scripts/build-apps.mjs --mode release --target desktop",
    "desktop:pack": "bun run desktop:buildRelease",
    "desktop:dist": "bun run desktop:buildRelease",
    "apk": "./gradlew :android:app:assembleDebug",
    "android:assembleDebug": "./gradlew :android:app:assembleDebug",
    "android:assembleRelease": "./gradlew :android:app:assembleRelease",
    "android:debug": "bun scripts/build-apps.mjs --mode debug --target android",
    "android:release": "bun scripts/build-apps.mjs --mode release --target android",
    "android:bundleRelease": "./gradlew :android:app:bundleRelease",
    "build:debug": "bun scripts/build-apps.mjs --mode debug --target both",
    "build:release": "bun scripts/build-apps.mjs --mode release --target both",
    "version:bump": "bun scripts/bump-version.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "bun server/src/index.ts"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@clerk/fastify": "^3.1.30",
    "@drone/assistant-markdown": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "@mariozechner/pi-agent-core": "workspace:*",
    "@mariozechner/pi-ai": "workspace:*",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fastify": "^5.8.5",
    "postcss": "^8.4.47",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.7",
    "ws": "^8.19.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.57.1",
    "vosk": "^0.3.39"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@electron/packager": "^18.4.4",
    "electron": "31.7.7",
    "typescript": "^5.6.3"
  }
}
