{
  "name": "drone-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "bun run build && bun run --filter drone build && node ../drone/dist/cli.js hub app --static-ui-dir dist",
    "build:size": "node scripts/build-size.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test tests",
    "test:coverage": "bun test --coverage tests",
    "lint": "bun run typecheck",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-cli.cjs"
  },
  "dependencies": {
    "@blip/protocol": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@drone/assistant-chat": "workspace:*",
    "@drone/assistant-markdown": "workspace:*",
    "@drone/device-protocol": "workspace:*",
    "@drone/file-icons": "workspace:*",
    "@drone/hub-model": "workspace:*",
    "@excalidraw/excalidraw": "^0.18.1",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.101.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "dockview": "^6.6.1",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.55.1",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-diff-view": "^3.3.2",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "refractor": "^3.6.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.7"
  }
}
