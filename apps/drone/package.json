{
  "name": "drone",
  "version": "0.1.0",
  "description": "Drone: per-container agent wrapper daemon + host CLI (via dvm)",
  "bin": {
    "drone": "dist/cli.js",
    "drone-hub-mcp-server": "dist/hub/mcp-server.js",
    "fleet": "dist/fleet.js",
    "tasks": "dist/tasks.js"
  },
  "main": "dist/cli.js",
  "type": "commonjs",
  "files": [
    "dist/**",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/postbuild.cjs",
    "clean": "rimraf dist",
    "dev": "ts-node src/cli.ts",
    "test": "bun test --timeout 20000 --max-concurrency 1 tests",
    "test:node": "bun run build && node --test tests/node/*.test.cjs",
    "test:coverage": "bun test --timeout 20000 --max-concurrency 1 --coverage tests",
    "test:auto-continue-eval": "bun test ./evals/agent-message-auto-continue.eval.ts",
    "test:agent-suggestion-eval": "bun test ./evals/agent-suggestion.eval.ts",
    "smoke": "node scripts/smoke-cli.cjs",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.29",
    "@ai-sdk/openai": "^3.0.26",
    "@mariozechner/pi-agent-core": "workspace:*",
    "@mariozechner/pi-ai": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ai": "^6.0.77",
    "better-sqlite3": "^12.10.0",
    "commander": "^12.1.0",
    "dotenv": "^17.2.4",
    "dvm": "workspace:*",
    "qrcode": "^1.5.4",
    "typescript": "^5.6.3",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "vosk": "^0.3.39"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.7.4",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2"
  }
}
