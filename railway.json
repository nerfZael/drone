{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "turbo run build --filter=voice-stream-next"
  },
  "deploy": {
    "startCommand": "bun run --filter voice-stream-next start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 60
  }
}
